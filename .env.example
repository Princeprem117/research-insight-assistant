# Research Insight Assistant - Environment Variables
# Copy to .env and fill in your values

# Required: OpenRouter API key for LLM access
OPENROUTER_APIKEY=sk-or-v1-your-key-here

# Optional: Model to use (defaults to anthropic/claude-sonnet-4)
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Optional: Frontend API URL (for Docker deployment)
# API_URL=http://localhost:8000